{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iPhone AI",
  "version": "0.9.2",
  "identifier": "me.alsaud.iphoneai",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.productivity",
    "copyright": "© 2026 Faisal Alsaud",
    "shortDescription": "Monitor and control your iPhone with AI through iPhone Mirroring.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/node", "binaries/iphone-ai-capture", "binaries/iphone-ai-input"],
    "resources": {
      "resources/server/": "server/",
      "resources/web/": "web/",
      "resources/claude-code/": "claude-code/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    }
  }
}
