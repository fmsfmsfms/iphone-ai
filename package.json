{
  "name": "iphone-ai",
  "version": "0.1.0",
  "private": true,
  "description": "iPhone AI — monitor and control a physical iPhone from macOS through Mirroir MCP, manual controls, and AI agents.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @iphone-ai/server dev",
    "dev:web": "pnpm --filter @iphone-ai/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @iphone-ai/web test:e2e",
    "test:device": "pnpm --filter @iphone-ai/server test:device",
    "package:mac": "node scripts/package-mac.mjs"
  }
}
