{
  "name": "@iphone-ai/server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:device": "IPHONE_AI_DEVICE_TESTS=1 vitest run test/device"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@anthropic-ai/sdk": "0.133.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@iphone-ai/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "openai": "7.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
